# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/mtmovies

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# Telebirr Proxy Configuration (REQUIRED for Railway deployment)
# Deploy the telebirr-proxy folder to Render and paste the URL here
# Example: https://telebirr-proxy.onrender.com
TELEBIRR_PROXY_URL=https://your-proxy.onrender.com

# Server Configuration
PORT=5000
NODE_ENV=development

# Telegram Configuration (for streaming)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION=your_session_string
