      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mtmoviess.netlify.app",
              "pathPrefix": "/details"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
