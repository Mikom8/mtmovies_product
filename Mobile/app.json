        "projectId": "d60c5aaa-6677-4577-871a-6ca71484d824"
      }
    },
    "notification": {
      "icon": "./assets/img/removebgIcon.png",
      "color": "#E50914"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 37,
            "targetSdkVersion": 37,
            "kotlinVersion": "2.0.21"
          }
        }
      ]
    ],
    "owner": "workhard8"
