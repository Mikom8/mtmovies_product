      "favicon": "./assets/img/ic_launcher.png"
    },
    "extra": {
      "EXPO_GOOGLE_CLIENT_ID": "1234-your-expo-client-id.apps.googleusercontent.com",
      "IOS_GOOGLE_CLIENT_ID": "5678-your-ios-client-id.apps.googleusercontent.com",
      "ANDROID_GOOGLE_CLIENT_ID": "733179551984-695g0hi3a8c0pl4rk5j7u7ii14seh8l5.apps.googleusercontent.com",
      "WEB_GOOGLE_CLIENT_ID": "733179551984-0ji089a9lptnkofd0es2jbdkpi6qfeb6.apps.googleusercontent.com",
